# ALPHA GENESIS local credentials. Copy to .env (start-macos.command does this for you).
# .env is git-ignored and should be readable only by you (chmod 600). Never commit or share it.
#
# Alpaca PAPER account keys (Alpaca dashboard > switch to "Paper" > API Keys > Generate).
# The same paper key pair is used for market data (data.alpaca.markets) and for the paper
# trading API (paper-api.alpaca.markets). Do NOT put live-account keys here: the app only
# ever talks to the paper endpoint, and live keys will simply be rejected.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional: require this token for dashboard control actions (kill switch, enabling trading, ...).
AG_OPERATOR_TOKEN=

# Optional: Alpha Vantage MCP data (free key: daily bars + FX only).
ALPHAVANTAGE_API_KEY=
