# Copy to .env (git-ignored). Never commit real values.
AG_OPERATOR_TOKEN=            # if set, dashboard/CLI control actions must send it as X-Operator-Token
ALPACA_API_KEY=               # only needed when [data] provider = "alpaca" (integration is UNVERIFIED)
ALPACA_API_SECRET=
ALPHAVANTAGE_API_KEY=         # Alpha Vantage MCP data (free key: daily bars + FX; 5-minute bars need a paid plan)
