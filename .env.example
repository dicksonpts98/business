# ---------------------------------------------------------------------------
# SupplyQuest HQ environment template. Copy to .env and fill in.
# NEVER commit a real .env. No secret values belong in this file.
# ---------------------------------------------------------------------------

# --- Database (required) ---
DATABASE_URL=postgres://supplyquest:CHANGE_ME@127.0.0.1:5432/supplyquest

# --- Server ---
PORT=8787
HOST=127.0.0.1
# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Execution mode ---
# demo  = deterministic seeded executor; every event is labelled SYNTHETIC_DEMO.
# live  = real model/tool adapters. Requires credentials below.
#         If credentials are absent, live mode reports DISCONNECTED.
#         It never silently falls back to demo results.
EXECUTION_MODE=demo

# --- Model provider (optional; required only for EXECUTION_MODE=live) ---
# Supported: anthropic | openai-compatible | demo
MODEL_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# For an OpenAI-compatible local endpoint. Capability parity is NOT claimed.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Compute budget guardrails (research spend, NOT business spend) ---
# Unset means "unset" and blocks live runs rather than assuming a number.
COMPUTE_BUDGET_USD_TOTAL=
COMPUTE_BUDGET_USD_PER_RUN=

# --- Worker ---
WORKER_CONCURRENCY=3
RUN_LEASE_SECONDS=90
RUN_HEARTBEAT_SECONDS=15
